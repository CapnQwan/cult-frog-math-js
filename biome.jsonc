{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "ignoreUnknown": true,
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
      },
      "complexity": {
        "noBannedTypes": "error",
        "useArrayFind": "error",
        "useSimplifiedLogicExpression": "error",
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noDoubleEquals": "error",
        "noDuplicateObjectKeys": "error",
        "noFallthroughSwitchClause": "error",
        "noImportCycles": "error",
        "noDuplicateDependencies": "error",
      },
      "security": {
        "noBlankTarget": "error",
        "noGlobalEval": "error",
        "noSecrets": "error",
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noDelete": "error",
        "noReExportAll": "off",
        "useTopLevelRegex": "error",
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noUselessTypeConversion": "error",
        "useAwaitThenable": "error",
        "useReduceTypeParameter": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
      },
      "style": {
        "noNegationElse": "error",
        "noUselessElse": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useSelfClosingElements": "error",
        "useExportType": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType",
          },
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "enum",
                },
                "formats": ["PascalCase", "CONSTANT_CASE"],
                "match": "E.+",
              },
              {
                "selector": {
                  "kind": "typeAlias",
                },
                "formats": ["PascalCase", "CONSTANT_CASE"],
                "match": "T.+",
              },
              {
                "selector": {
                  "kind": "interface",
                },
                "formats": ["PascalCase", "CONSTANT_CASE"],
                "match": "I.+",
              },
              {
                "selector": {
                  "kind": "typeParameter",
                },
                "formats": ["PascalCase", "CONSTANT_CASE"],
              },
            ],
          },
        },
        "noValueAtRule": "error",
      },
    },
  },
  "json": {
    "linter": {
      "enabled": true,
    },
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "jsxQuoteStyle": "double",
    },
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                {
                  "type": false,
                  "source": [
                    ":URL:",
                    ":PACKAGE_WITH_PROTOCOL:",
                    ":NODE:",
                    ":BUN:",
                    ":PACKAGE:",
                    "!**/*.json",
                    "!**/*.css",
                    "!**/*.scss",
                  ],
                },
              ],
              ":BLANK_LINE:",
              [
                {
                  "type": false,
                  "source": [
                    ":ALIAS:",
                    ":PATH:",
                    "!**/types",
                    "!**/types.ts",
                    "!**/types.tsx",
                    "!**/types/**",
                    "!**/*.types",
                    "!**/*.types.ts",
                    "!**/*.types.tsx",
                    "!**/*.json",
                    "!**/*.css",
                    "!**/*.scss",
                  ],
                },
              ],
              ":BLANK_LINE:",
              [
                {
                  "type": true,
                },
                {
                  "type": false,
                  "source": [
                    "**/types",
                    "**/types.ts",
                    "**/types/**",
                    "**/*.types",
                    "**/*.types.ts",
                  ],
                },
              ],
              ":BLANK_LINE:",
              [
                {
                  "type": false,
                  "source": ["**/*.json"],
                },
              ],
              ":BLANK_LINE:",
              [
                {
                  "type": false,
                  "source": [
                    "**/*.css",
                    "**/*.scss",
                    "**/*.module.css",
                    "**/*.module.scss",
                  ],
                },
              ],
            ],
          },
        },
      },
    },
  },
}
