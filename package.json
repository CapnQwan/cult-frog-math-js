{
  "name": "@cult-frog/math",
  "version": "0.0.0",
  "description": "A TypeScript math library for game development: vectors, matrices, quaternions, and numerical utilities.",
  "license": "MIT",
  "author": "Quin Partridge",
  "keywords": [
    "math",
    "vector",
    "matrix",
    "quaternion",
    "gamedev",
    "linear-algebra",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapnQwan/cult-frog-math-js.git"
  },
  "bugs": {
    "url": "https://github.com/CapnQwan/cult-frog-math-js/issues"
  },
  "homepage": "https://github.com/CapnQwan/cult-frog-math-js#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vec2": {
      "types": "./dist/vec2.d.ts",
      "default": "./dist/vec2.js"
    },
    "./vec3": {
      "types": "./dist/vec3.d.ts",
      "default": "./dist/vec3.js"
    },
    "./vec4": {
      "types": "./dist/vec4.d.ts",
      "default": "./dist/vec4.js"
    },
    "./mat2": {
      "types": "./dist/mat2.d.ts",
      "default": "./dist/mat2.js"
    },
    "./mat3": {
      "types": "./dist/mat3.d.ts",
      "default": "./dist/mat3.js"
    },
    "./mat4": {
      "types": "./dist/mat4.d.ts",
      "default": "./dist/mat4.js"
    },
    "./quat": {
      "types": "./dist/quat.d.ts",
      "default": "./dist/quat.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "check": "biome check . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "fix": "biome check . --write",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cult-frog/tooling": "^0.1.1",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@cult-frog/types": "^0.1.0"
  }
}
